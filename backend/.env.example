# Copy this file to .env and fill in your values

# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reliavolt_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Server
PORT=4000

# JWT — change this to a long random secret in production
JWT_SECRET=reliavolt_super_secret_change_me
JWT_EXPIRES_IN=8h

# Frontend origin for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5500

# Frontend base URL used to build password-reset links (no trailing slash)
FRONTEND_URL=https://achieverbangs.github.io/reliavolt-inventory/Reliavolt-Inventory-Frontend

# Resend (https://resend.com) — used to send password-reset emails.
# RESEND_FROM must use a domain verified in your Resend dashboard.
RESEND_API_KEY=re_your_api_key
RESEND_FROM=Reliavolt Supply <noreply@reliavoltsupply.shop>
